<ResourceDictionary 
xmlns="https://github.com/avaloniaui"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
>

<SolidColorBrush x:Key="PrimaryColor">#62B9CB</SolidColorBrush>
<SolidColorBrush x:Key="secondColor">#BEE9E7</SolidColorBrush>

<SolidColorBrush x:Key="accentColor">#1B4B65</SolidColorBrush>

<SolidColorBrush x:Key="sectionColor">#5FACD3</SolidColorBrush>
<SolidColorBrush x:Key="AppBackgroundColor">#CAEBFF</SolidColorBrush>





</ResourceDictionary>