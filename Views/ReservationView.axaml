<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Gestion_avion.ViewModels"
             x:Class="Gestion_avion.Views.ReservationView"
             x:DataType="vm:ReservationViewModel">

    <UserControl.Styles>

        <!-- hover-->
        <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource secondColor}"/> 
            <Setter Property="BorderBrush" Value="{DynamicResource secondColor}"/> 
        </Style>

        <!-- focus-->
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource secondColor}"/> 
            <Setter Property="BorderBrush" Value="{DynamicResource hoverColor}"/> 
        </Style>

        <!-- while writing -->
        <Style Selector="TextBox:focus">
            <Setter Property="Foreground" Value="Black"/>
        </Style>
        

    </UserControl.Styles>

    <Grid Margin="20"
          ColumnSpacing="20">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1.5*"/>
        </Grid.ColumnDefinitions>
        
        <!-- gauche  -->
        <ScrollViewer>

            <Border Grid.Column="0"
                Background="WhiteSmoke"
                CornerRadius="16"
                Padding="20"
                VerticalAlignment="Stretch">
            
            <StackPanel Spacing="15">

                <TextBlock Text="Reservation"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="{DynamicResource accentColor}"/>

                <!-- ID passeport -->
                 <StackPanel Spacing="5">
                    <TextBlock Text="ID Passeport"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource accentColor}"/>
                    <TextBox Text="{Binding IdPasseport, Mode=TwoWay}"
                             CornerRadius="10"
                             Background="{DynamicResource secondColor}"
                             Foreground="Black"/>
                    
                </StackPanel>

                <!-- nom  -->
                <StackPanel Spacing="5">
                    <TextBlock Text="Nom"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource accentColor}"/>
                    <TextBox Text="{Binding Nom, Mode=TwoWay}"
                             CornerRadius="10"
                             Background="{DynamicResource secondColor}"
                             Foreground="Black"/>
                             
                </StackPanel>

                <!-- prenom  -->
                <StackPanel Spacing="5">
                    <TextBlock Text="Prenom"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource accentColor}"/>
                    <TextBox Text="{Binding Prenom, Mode=TwoWay}"
                             CornerRadius="10"
                             Background="{DynamicResource secondColor}"
                             Foreground="Black"/>
                            
                </StackPanel>

                <!-- nb personne  -->
                <StackPanel Spacing="5">
                   <TextBlock Text="Categorie personne"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource accentColor}"/>
                                <ComboBox HorizontalAlignment="Stretch"
                                        PlaceholderText="Selectionner..."
                                        Foreground="White"
                                        FontWeight="Bold"
                                        SelectedItem="{Binding CategoriePersonne, Mode=TwoWay}">

                                    <x:String>Adulte</x:String>
                                    <x:String>Enfant</x:String>
                                    <x:String>Bébé</x:String>

                                </ComboBox>
                </StackPanel>

                <!-- classe  -->
                <StackPanel Spacing="5">
                   <TextBlock Text="Classe"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource accentColor}"/>
                                <ComboBox HorizontalAlignment="Stretch"
                                        PlaceholderText="Selectionner..."
                                        Foreground="White"
                                        FontWeight="Bold"
                                        SelectedItem="{Binding ClasseAvion, Mode=TwoWay}">

                                    <x:String>Economique</x:String>
                                    <x:String>Economique Premium</x:String>
                                    <x:String>classe Affaire</x:String>
                                    <x:String>Première classe</x:String>


                                </ComboBox>
                </StackPanel>

                <!-- compagnie aerienne  -->
                <StackPanel Spacing="5">
                   <TextBlock Text="Compagnie Aerienne"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource accentColor}"/>
                                <ComboBox HorizontalAlignment="Stretch"
                                        PlaceholderText="Selectionner..."
                                        Foreground="White"
                                        FontWeight="Bold"
                                        SelectedItem="{Binding CompagnieAerienne, Mode=TwoWay}">

                                    <x:String>Madagascar Airlines</x:String>
                                    <x:String>Ethiopan Airlines</x:String>
                                    <x:String>Air Françe</x:String>
                                    <x:String>Air Mauritus</x:String>


                                </ComboBox>
                </StackPanel>

                <!-- type de vol  -->
                <StackPanel Spacing="5">
                   <TextBlock Text="Type de vol"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource accentColor}"/>
                                <ComboBox HorizontalAlignment="Stretch"
                                        PlaceholderText="Selectionner..."
                                        Foreground="White"
                                        FontWeight="Bold"
                                        SelectedItem="{Binding TypeVol, Mode=TwoWay}">

                                    <x:String>Aller simple</x:String>
                                    <x:String>Aller-retour</x:String>
                                    
                                </ComboBox>
                </StackPanel>

                <!-- sejour  -->
                <StackPanel Spacing="5" IsVisible="{Binding IsSejourVisible}">
                   <TextBlock Text="Sejour"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource accentColor}"/>

                        <TextBox Text="{Binding Sejour, Mode=TwoWay}"
                                CornerRadius="10"
                                Background="{DynamicResource secondColor}"
                                Foreground="Black"/>
                </StackPanel>

                <!-- Boutons-->
                <StackPanel Spacing="5">

                    <Grid ColumnSpacing="15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/> 
                    </Grid.ColumnDefinitions>

                    <!-- Bouton reserver-->
                    <Button Grid.Column="0" 
                            Content="Reserver"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Background="{DynamicResource accentColor}"
                            Foreground="White"
                            FontWeight="Bold"/>

                    <!-- Bouton annuler -->
                    <Button Grid.Column="1" 
                            Content="Annuler"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Background="#ADADAD"
                            Foreground="White"
                            FontWeight="Bold"/>
                    </Grid>

                </StackPanel>

            </StackPanel>          
        </Border>

        </ScrollViewer>


        <!-- droite  -->
        <Grid Grid.Column="1" 
              RowSpacing="20">

              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> 
                <RowDefinition Height="*"/>    
            </Grid.RowDefinitions>
            
            <!-- pt1  -->
             <Border Grid.Row="0" 
                        Background="WhiteSmoke"
                        CornerRadius="15"
                        Padding="20">
                    
                    <StackPanel Spacing="10">
                        <TextBlock Text="Voyagé de"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource accentColor}"/>
                        

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                        

                        <!-- ville de depart  -->
                        <StackPanel Grid.Column="0"
                                Spacing="5">
                            <TextBlock Text="Depart"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource accentColor}"/>
                                <ComboBox HorizontalAlignment="Stretch"
                                        PlaceholderText="Selectionner..."
                                        Foreground="White"
                                        FontWeight="Bold"
                                        ItemsSource="{Binding VilleDisponibles}"
                                        SelectedItem="{Binding VilleDepart, Mode=TwoWay}">

                                    <!-- mock data  -->
                                    <x:String>Antananarivo</x:String>
                                    <x:String>Fianarantsoa</x:String>
                                    <x:String>Toamasina</x:String>

                                </ComboBox>
                        </StackPanel>
                        
                        <TextBlock Grid.Column="1" 
                                    Text="➔" 
                                    FontSize="18" 
                                    VerticalAlignment="Bottom" 
                                    Margin="0,0,0,10"
                                    Foreground="Gray"/>

                        <!-- destination  -->
                        <StackPanel Grid.Column="2"
                                Spacing="5">
                            <TextBlock Text="Destination"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource accentColor}"/>
                                <ComboBox HorizontalAlignment="Stretch"
                                        PlaceholderText="Selectionner..."
                                        Foreground="White"
                                        FontWeight="Bold"
                                        ItemsSource="{Binding VilleDisponibles}"
                                        SelectedItem="{Binding VilleArrivee, Mode=TwoWay}">

                                    <!-- mock data  -->
                                    <x:String>Toliara</x:String>
                                    <x:String>Antsirabe</x:String>
                                    <x:String>Nosy Be</x:String>

                                </ComboBox>
                        </StackPanel>
                    </Grid>

                    <!-- date et heure  -->
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                         <!-- Date du vol -->
                        <StackPanel Grid.Column="0" Spacing="5">

                            <TextBlock Text="Date" 
                                        FontWeight="SemiBold" 
                                        Foreground="{DynamicResource accentColor}"/>

                            <ComboBox HorizontalAlignment="Stretch"
                                        PlaceholderText="Selectionner..."
                                        Foreground="White"
                                        FontWeight="Bold"
                                        SelectedItem="{Binding DateVol, Mode=TwoWay}">

                                    <!-- mock data  -->
                                    <x:String>06/08/2026</x:String>
                                    <x:String>18/08/22026</x:String>
                                    <x:String>30/08/2026</x:String>

                                </ComboBox>
                        </StackPanel>

                        <TextBlock Grid.Column="1" 
                                Text="à" 
                                FontSize="14" 
                                VerticalAlignment="Bottom" 
                                Margin="0,0,0,10"
                                Foreground="{DynamicResource accentColor}"/>

                        <!-- Heure du vol -->
                        <StackPanel Grid.Column="2" 
                                    Spacing="5">

                            <TextBlock Text="Heure" 
                                        FontWeight="SemiBold" 
                                        Foreground="{DynamicResource accentColor}"/>

                            <ComboBox HorizontalAlignment="Stretch"
                                        PlaceholderText="Selectionner..."
                                        Foreground="White"
                                        FontWeight="Bold"
                                        SelectedItem="{Binding HeureVol, Mode=TwoWay}">

                                    <!-- mock data  -->
                                    <x:String>03:00</x:String>
                                    <x:String>14:30</x:String>
                                    <x:String>22:15</x:String>

                                </ComboBox>
                                    
                        </StackPanel>

                    </Grid>

                </StackPanel>

            </Border>

            <!-- pt2  -->
             <Border Grid.Row="1"    
                        Background="WhiteSmoke"
                        CornerRadius="15"
                        Padding="20"
                        VerticalAlignment="Stretch">
                    
                    <StackPanel Spacing="10">
                        <TextBlock Text="places"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource accentColor}"/>
                        
                        <TextBlock Text="stuff" 
                                   Foreground="Gray" 
                                   FontStyle="Italic"/>
                    </StackPanel>
            </Border>


        </Grid>

    </Grid>

</UserControl>