<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pages="using:Gestion_avion.Views.Pages"
        xmlns:vm="using:Gestion_avion.ViewModels"
        x:DataType="vm:MainViewModel"
        x:Class="Gestion_avion.Views.MainWindow"
        Title="Fast Travel"
        Width="900" Height="600"
        WindowStartupLocation="CenterScreen">

    <Window.Styles>
        <!-- hover -->
        <Style Selector="Button:pointerover /template/ ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource accentColor}"/>     
            <Setter Property="Background" Value="{DynamicResource secondColor}"/> 
        </Style>
    </Window.Styles>
    
    <Grid>
        <!--toogle interface for login-->
        <ContentControl  IsVisible="{Binding !IsLoading}" Content="{Binding CurrentInterface}"/>

        <!-- Loading -->
        <pages:WelcomeView IsVisible="{Binding IsLoading}"/>
    </Grid>
</Window>