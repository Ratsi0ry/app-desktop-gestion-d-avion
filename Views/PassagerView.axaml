<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Gestion_avion.ViewModels"
             x:Class="Gestion_avion.Views.PassagerView"
             x:DataType="vm:PassagerViewModel"
             x:Name="Root">

    <UserControl.Styles>

        <!-- hover-->
        <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource accentColor}"/> 
            <Setter Property="BorderBrush" Value="{DynamicResource accentColor}"/> 
        </Style>

        <!-- focus-->
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource accentColor}"/> 
            <Setter Property="BorderBrush" Value="{DynamicResource accentColor}"/> 
        </Style>

        <!-- while writing --> 
        <Style Selector="TextBox:focus">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        
    </UserControl.Styles>


    <!-- liste -->
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">

        <Border Background="WhiteSmoke"
            CornerRadius="15"
            Padding="20"
            HorizontalAlignment="Stretch">
        
        <StackPanel Spacing="15" MinWidth="1300">

            <Grid>
                <Grid ColumnSpacing="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="5.5*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                            Text="Listes passagers"
                            FontSize="20"
                            FontWeight="Bold"
                            Foreground="{DynamicResource accentColor}"/>

                    <TextBox Grid.Column="1" 
                            PlaceholderText="Rechercher"
                            FontSize="16"
                            Foreground="White"
                            Width="200"
                            HorizontalAlignment="Right"
                            Background="{DynamicResource accentColor}"
                            CornerRadius="25"
                            Margin="0,0,55,0"
                            TextAlignment="Center"
                            Text="{Binding RechercheId, Mode= TwoWay}"/>


                </Grid>
            </Grid>


            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1.2*"/>



                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" 
                            Text=" ID Passeport" 
                            FontWeight="Bold" 
                            Foreground="Gray"/>

                <TextBlock Grid.Column="1" 
                            Text="Nom" 
                            FontWeight="Bold" 
                            Foreground="Gray"/>

                <TextBlock Grid.Column="2" 
                            Text="Prenom" 
                            FontWeight="Bold" 
                            Foreground="Gray"/>

                <TextBlock Grid.Column="3" 
                            Text="Categorie" 
                            FontWeight="Bold" 
                            Foreground="Gray"/>

                <TextBlock Grid.Column="4" 
                            Text="Classe" 
                            FontWeight="Bold" 
                            Foreground="Gray"/>

                <TextBlock Grid.Column="5" 
                            Text="Compagnie" 
                            FontWeight="Bold" 
                            Foreground="Gray"/>

                <TextBlock Grid.Column="6" 
                            Text="Type vol" 
                            FontWeight="Bold" 
                            Foreground="Gray"/>

                <TextBlock Grid.Column="7" 
                            Text="Départ" 
                            FontWeight="Bold" 
                            Foreground="Gray"/>

                <TextBlock Grid.Column="8" 
                            Text="Destination" 
                            FontWeight="Bold" 
                            Foreground="Gray"/>

                <TextBlock Grid.Column="9" 
                            Text="Date" 
                            FontWeight="Bold" 
                            Foreground="Gray"/>

                <TextBlock Grid.Column="10" 
                            Text="Heure" 
                            FontWeight="Bold" 
                            Foreground="Gray"/>

                <TextBlock Grid.Column="11" 
                            Text="Place" 
                            FontWeight="Bold" 
                            Foreground="Gray"/>

                <TextBlock Grid.Column="12" 
                            Text="Tarif" 
                            FontWeight="Bold" 
                            Foreground="Gray"/>

                <TextBlock Grid.Column="13" 
                            Text="Staut" 
                            FontWeight="Bold" 
                            Foreground="Gray"/>

                <TextBlock Grid.Column="14" 
                            Text="Actions" 
                            FontWeight="Bold" 
                            Foreground="Gray"/>


            </Grid>

            <!-- space-->
            <Rectangle Height="1" Fill="#DDDDDD"/>

            <ItemsControl ItemsSource="{Binding ListeClients}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1.2*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" 
                                        Text="{Binding IdPasseport}" 
                                        VerticalAlignment="Center" 
                                        Foreground="Black"/>

                            <TextBlock Grid.Column="1" 
                                    Text="{Binding Nom}" 
                                    VerticalAlignment="Center" 
                                    Foreground="Black"/>

                            <TextBlock Grid.Column="2" 
                                        Text="{Binding Prenom}" 
                                        VerticalAlignment="Center" 
                                        Foreground="Black"/>

                            <TextBlock Grid.Column="3" 
                                        Text="{Binding Categorie}" 
                                        VerticalAlignment="Center" 
                                        Foreground="Black"/>

                            <TextBlock Grid.Column="4" 
                                        Text="{Binding Classe}" 
                                        VerticalAlignment="Center" 
                                        Foreground="Black"/>

                            <TextBlock Grid.Column="5" 
                                        Text="{Binding Compagnie}" 
                                        VerticalAlignment="Center" 
                                        Foreground="Black"/>

                            <TextBlock Grid.Column="6" Text="{Binding TypeVol}" 
                                        VerticalAlignment="Center" 
                                        Foreground="Black"/>

                            <TextBlock Grid.Column="7" 
                                        Text="{Binding Depart}" 
                                        VerticalAlignment="Center" 
                                        Foreground="Black"/>

                            <TextBlock Grid.Column="8" 
                                        Text="{Binding Destination}" 
                                        VerticalAlignment="Center" 
                                        Foreground="Black"/>

                            <TextBlock Grid.Column="9" 
                                        Text="{Binding Date}" 
                                        VerticalAlignment="Center" 
                                        Foreground="Black"/>

                            <TextBlock Grid.Column="10" 
                                        Text="{Binding Heure}" 
                                        VerticalAlignment="Center" 
                                        Foreground="Black"/>

                            <!-- affichage siege  -->
                            <TextBlock Grid.Column="11" 
                                        Text="{Binding Siege}" 
                                        VerticalAlignment="Center" 
                                        Foreground="{DynamicResource accentColor}"/>

                            <TextBlock Grid.Column="12" 
                                        Text="{Binding Tarif, StringFormat={}{0} Ar}" 
                                        VerticalAlignment="Center" 
                                        Foreground="Black"/>

                            <TextBlock Grid.Column="13" 
                                        Text="{Binding EstPaye}" 
                                        VerticalAlignment="Center" 
                                        FontWeight="SemiBold"
                                        Foreground="Black"/>

                            <!-- btn modifier  -->
                            <StackPanel Grid.Column="14" 
                                        Orientation="Horizontal" 
                                        Spacing="5">
                                <Button ToolTip.Tip="Modifier"
                                        Command="{Binding #Root.DataContext.ModifierClientCommand}"
                                        CommandParameter="{Binding}">

                                    <StackPanel Orientation="Horizontal" 
                                                Spacing="8">
                                        <Image Source="avares://Gestion_avion/Assets/edit.png" Width="24" Height="24" />
                                    </StackPanel>
                                </Button>
                                <!-- btn supprimer  -->
                                <Button ToolTip.Tip="Supprimer"
                                        Foreground="White"
                                        Command="{Binding #Root.DataContext.SupprimerClientCommand}"
                                        CommandParameter="{Binding}">

                                    <StackPanel Orientation="Horizontal" 
                                                Spacing="8">
                                        <Image Source="avares://Gestion_avion/Assets/delete-1-svgrepo-com.png" Width="24" Height="24" />
                                    </StackPanel>
                                    
                                </Button>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </Border>

    </ScrollViewer>

</UserControl>