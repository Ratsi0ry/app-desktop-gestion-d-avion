<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Gestion_avion.ViewModels"
             x:Class="Gestion_avion.Views.VolsView"
             x:DataType="vm:VolsViewModel">

    <UserControl.Styles>

        <!-- hover-->
        <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource secondColor}"/> 
            <Setter Property="BorderBrush" Value="{DynamicResource secondColor}"/> 
        </Style>

        <!-- focus-->
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource secondColor}"/> 
            <Setter Property="BorderBrush" Value="{DynamicResource hoverColor}"/> 
        </Style>

        <!-- while writing -->
        <Style Selector="TextBox:focus">
            <Setter Property="Foreground" Value="Black"/>
        </Style>

    </UserControl.Styles>

    <Grid ColumnDefinitions="2*, 4*, 4*">
        <!--global overview-->
        <ScrollViewer   Padding="20"
                        Grid.Column="0">
            <WrapPanel HorizontalAlignment="Stretch"
                        Orientation="Vertical"
                        ItemSpacing="20"
                        VerticalAlignment="Center">
                <!--on flight-->
                <Border CornerRadius="20"
                        Padding="10,20,5,20"
                        Background="WhiteSmoke">
                    <StackPanel Orientation="Vertical">
                        <TextBlock  HorizontalAlignment="Center"
                                    FontSize="20"
                                    FontWeight="Bold"
                                    Foreground="Black"
                                    Text="en cours"/>
                        <TextBlock Text="10"/>
                    </StackPanel>

                </Border>

                <!--waiting-->
                <Border CornerRadius="20"
                        Padding="10,20,5,20"
                        Background="WhiteSmoke">
                    <StackPanel Orientation="Vertical">
                        <TextBlock  HorizontalAlignment="Center"
                                    FontSize="20"
                                    FontWeight="Bold"
                                    Foreground="Black"
                                    Text="en attente"/>
                        <TextBlock Text="10"/>
                    </StackPanel>
                </Border>

                <!--cancelled-->
                <Border CornerRadius="20"
                        Padding="10,20,5,20"
                        Background="WhiteSmoke">
                    <StackPanel Orientation="Vertical">
                        <TextBlock  HorizontalAlignment="Center"
                                    FontSize="20"
                                    FontWeight="Bold"
                                    Foreground="Black"
                                    Text="annulee"/>
                        <TextBlock Text="10"/>
                    </StackPanel>
                </Border>

                <!--delaied-->
                <Border CornerRadius="20"
                        Padding="10,20,5,20"
                        Background="WhiteSmoke">
                    <StackPanel Orientation="Vertical">
                        <TextBlock  HorizontalAlignment="Center"
                                    FontSize="20"
                                    FontWeight="Bold"
                                    Foreground="Black"
                                    Text="retardes"/>
                        <TextBlock Text="2"/>
                    </StackPanel>
                </Border>
            </WrapPanel>
        </ScrollViewer>

        <!--flight list-->
        <ScrollViewer   Padding="20"
                        Grid.Column="1">
            <Border Padding="20"
                    CornerRadius="20"
                    Background="WhiteSmoke">
                <StackPanel HorizontalAlignment="Center"
                            Orientation="Vertical">
                    <!--contents-->
                    <TextBlock Text="for :"/>
                    <DatePicker/>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!--plannification-->
        <ScrollViewer   Padding="20"
                        Grid.Column="2">
            <Border CornerRadius="20"
                    Padding="20"
                    Background="WhiteSmoke">
                <StackPanel HorizontalAlignment="Stretch"
                            Orientation="Vertical">
                    <!--point a-->
                    <TextBlock Text="ville de depart"/>
                    <ComboBox PlaceholderText="aeroport de"/>

                    <!--point b-->
                    <TextBlock Text="ville d'arrivee"/>
                    <ComboBox PlaceholderText="aeroport de"/>

                    <!--plane-->
                    <TextBlock Text="avion pour le trajet"/>
                    <ComboBox PlaceholderText="nom de l'avion"/>

                    <!--date and time-->
                    <TextBlock Text="date et heure de depart"/>
                    <DatePicker/>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
        
</UserControl>