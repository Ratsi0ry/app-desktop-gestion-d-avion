<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Gestion_avion.ViewModels"
             x:DataType="vm:PlaneStatusViewModel"
             x:Class="Gestion_avion.Views.Cards.PlaneStatus">
    

    <Panel>
        <!--base layout-->
        <Grid RowDefinitions="1*,3*,6*"
              ZIndex="1"
              IsVisible="{Binding IsStatus}">
            <!--delete plane-->
                    <Button Width="60"
                            Grid.Row="0"
                            HorizontalContentAlignment="Right"
                            VerticalAlignment="Top"
                            Padding="0"
                            Margin="0"
                            Height="60"
                            CornerRadius="60"
                            Command="{Binding DeleteCommand}">
                        <Image Source="avares://Gestion_avion/Assets/delete-1-svgrepo-com.png"
                               HorizontalAlignment="Center"/>
                        <ToolTip.Tip>
                            <TextBlock Foreground="White"
                                       Text="supprimer l'avion"/>
                        </ToolTip.Tip>
                    </Button>
            <!--general info-->
            <Border HorizontalAlignment="Center">
                
                <StackPanel Grid.Row="0"
                            Spacing="5"
                            Margin="0,0,10,0"
                            Orientation="Vertical">
                    
                    <StackPanel Margin="10"
                                HorizontalAlignment="Center"
                                Orientation="Horizontal">
                        <TextBlock  FontSize="18"
                                    Padding="10,0,0,0"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource accentColor}"
                                    Text="name :"/>
                        <TextBlock  Name="plane_name"
                                    FontSize="16"
                                    Foreground="Black"
                                    Text="{Binding PlaneName}"/>
                        
                        <TextBlock  FontSize="18"
                                    Padding="10,0,0,0"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource accentColor}"
                                    Text="id :"/>
                        <TextBlock  Name="Plane_id"
                                    Foreground="Black"
                                    FontSize="16"
                                    Text="{Binding PlaneId}"/>
                    </StackPanel>
    
                    <StackPanel Margin="10"
                                HorizontalAlignment="Center"
                                Orientation="Horizontal">
                        
                        <TextBlock  Padding="10,0,0,0"
                                    FontSize="18"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource accentColor}"
                                    Text="companie proprietaire :"/>
                        <TextBlock  Name="owningCompany"
                                    Foreground="Black"
                                    FontSize="16"
                                    Text="{Binding Owner}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
    
            <!--plane view-->
            <Border Padding="10"
                    Grid.Row="1"
                    CornerRadius="20">
                <Image  MaxHeight="450"
                        Source="avares://Gestion_avion/Assets/AirbusA320.png"/>
            </Border>
    
            <!--Status-->
            <Border Padding="20" 
                    Grid.Row="2">
                <Grid ColumnDefinitions="0.33*,0.33*,0.33*">
    
                    <!--places-->
                    <StackPanel Grid.Column="0"
                                VerticalAlignment="Top"
                                HorizontalAlignment="Left"
                                Margin="10"
                                Orientation="Vertical">
                        <TextBlock  HorizontalAlignment="Center"
                                    Padding="10"
                                    FontSize="18"
                                    Foreground="{StaticResource accentColor}"
                                    FontWeight="Bold"
                                    Text="nombre de place"/>
    
                        <TextBlock  FontSize="16"
                                    Padding="0,10,0,0"
                                    Text="laces total :"/>
                        <TextBlock  FontSize="14"
                                    Padding="5,5,0,0"
                                    HorizontalAlignment="Left"
                                    Text="{Binding Places}"/>
    
                        <ItemsControl   ItemsSource="{Binding PlaneClasses}"
                                        Foreground="Black">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel ItemSpacing="3" Orientation="Vertical"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                                
                    </StackPanel>
    
                    <!--status per date-->
                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Top"
                                HorizontalAlignment="Left"
                                Margin="10"
                                Orientation="Vertical">
    
                        <TextBlock  HorizontalAlignment="Center"
                                    Padding="10"
                                    FontSize="18"
                                    Foreground="{StaticResource accentColor}"
                                    FontWeight="Bold"
                                    Text="Status du"/>
                        <TextBlock  FontSize="16"
                                    Text="{Binding ViewDate}"/>
    
                        <TextBlock  FontSize="16"
                                    Text="en vol"/>
    
                        <TextBlock  FontSize="16"
                                    FontWeight="Bold"
                                    Padding="5,10"
                                    Text="de :"/>
                        <TextBlock  FontSize="14"
                                    Text="{Binding PointA}"/>
    
                        <TextBlock  FontSize="16"
                                    Padding="5,0,5,5"
                                    FontWeight="Bold"
                                    Text="a :"/>
                        <TextBlock  FontSize="14"
                                    Text="{Binding PointB}"/>
                    </StackPanel>
    
                    <!--linked country-->
                    <StackPanel Grid.Column="2"
                                VerticalAlignment="Top"
                                HorizontalAlignment="Left"
                                Margin="10"
                                Orientation="Vertical">
                        <TextBlock  HorizontalAlignment="Center"
                                    Padding="10"
                                    FontSize="18"
                                    Foreground="{StaticResource accentColor}"
                                    FontWeight="Bold"
                                    Text="Aeroport reliee"/>
                        <TextBlock  Foreground="{StaticResource hoverColor}"
                                    FontSize="16"
                                    Text="{Binding PointA}"/>
    
                        <TextBlock  Text="et :"
                                    FontWeight="Bold"
                                    Padding="10,5"
                                    Foreground="{StaticResource accentColor}"
                                    FontSize="18"/>
                        <TextBlock  Foreground="{StaticResource hoverColor}"
                                    FontSize="16"
                                    Text="{Binding PointB}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!--new-->
        <Grid IsVisible="{Binding IsNew}">
            <Border CornerRadius="20">
                <StackPanel Orientation="Vertical">
                    
                </StackPanel>
            </Border>
        </Grid>

    </Panel>

</UserControl>