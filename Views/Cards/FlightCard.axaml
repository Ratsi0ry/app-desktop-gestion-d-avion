<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Gestion_avion.ViewModels"
             x:DataType="vm:FlightCardViewModel"
             x:Class="Gestion_avion.Views.Cards.FlightCard">


    <Border HorizontalAlignment="Stretch"
            Background="{StaticResource secondColor}"
            CornerRadius="15">
        <Grid ColumnDefinitions="8*,2*"  
              RowDefinitions="7*,3*">
            <!--plane status-->
            <StackPanel Grid.Column="0"
                        Grid.Row="0"
                        Orientation="Horizontal">
                <!--plane image-->
                <Border Height="70"
                        Width="70"
                        CornerRadius="70"
                        Background="White"/>
                <!--plane name and owning company-->
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="{Binding Plane}"/>
                    <TextBlock Text="{Binding Company}"/>
                </StackPanel>
            </StackPanel>
    
            <!--flight details-->
            <StackPanel Grid.Row="1"
                        Grid.Column="0"
                        Orientation="Vertical">

                <!--linked ports-->
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="voyage de :"/>
                    <TextBlock Text="{Binding PortA}"/>
                    <TextBlock Text="a"/>
                    <TextBlock Text="{Binding PortB}"/>
                </StackPanel>

                <!--departure time-->
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="depart prevue pour:"/>
                    <TextBlock Text="{Binding Depart}"/>
                </StackPanel>
                <!--status-->
                <TextBlock Text="en vol"/>
                <!--delayed-->
                <StackPanel IsVisible="False"
                            Orientation="Horizontal">
                    <TextBlock Text="retardee pour :"/>
                    <TextBlock Text="20h30m"/>
                </StackPanel>
            </StackPanel>

            <!--actions-->
            <StackPanel Grid.Column="1"
                        Grid.RowSpan="2"
                        VerticalAlignment="Center"
                        Orientation="Vertical">
                <Button Content="cancel"/>
                <Button Content="delay"/>
            </StackPanel>
        </Grid>
    </Border>
            
</UserControl>